# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
**/coverage
**/coverage.json

# next.js / build output
**/.next/
**/out/
**/.vercel/
**/dist/
**/build/

# hardhat generated output
**/artifacts/
**/cache/
**/typechain-types/

# local env files — never commit secrets
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# keep documented templates in git
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# sensitive
.private_key

# local reference clone (separate git repo, do not commit)
/JPay/

# Kilo agent / skill directories (tool config, not project source)
.agents/
.claude/
agent/
skills-lock.json
