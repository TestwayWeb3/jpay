# ---- Privy (required) ----
# https://dashboard.privy.io -> your app -> App ID
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional, only when your Privy project uses a client ID
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ---- JPay contract (required) ----
# Monad Testnet deployment: packages/contracts/deployments/monadTestnet.json
NEXT_PUBLIC_JPAY_PAYMENT_ADDRESS=0x654DDF8dc6e31C9e024E4009DBb3830b5E506E9a

# ---- Optional ----
# Canonical URL for metadata/OpenGraph only, e.g. https://jpay.vercel.app
# Payment links and QR codes always use window.location.origin, so this is
# not needed for Vercel deploys.
NEXT_PUBLIC_SITE_URL=

# RPC overrides. Defaults to the public Monad RPCs when empty.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
NEXT_PUBLIC_MONAD_RPC_URL=
