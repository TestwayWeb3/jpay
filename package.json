{
  "name": "jpay",
  "version": "1.0.0",
  "private": true,
  "description": "JPay — QR payments for local merchants in Yogyakarta, settled on Monad.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jpay/web",
    "build": "npm run build -w @jpay/web",
    "start": "npm run start -w @jpay/web",
    "lint": "npm run lint -w @jpay/web",
    "typecheck": "npm run typecheck -w @jpay/web",
    "check:chain": "node scripts/healthcheck.mjs",
    "contracts:compile": "npm run compile -w @jpay/contracts",
    "contracts:test": "npm run test -w @jpay/contracts",
    "contracts:deploy:testnet": "npm run deploy:testnet -w @jpay/contracts",
    "contracts:create-payment:testnet": "npm run create-payment:testnet -w @jpay/contracts"
  },
  "engines": {
    "node": ">=18.17"
  }
}
